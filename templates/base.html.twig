<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}FactuPro{% endblock %}</title>
        <style>
            body { font-family: sans-serif; margin: 0; background: #f4f6f8; color: #1b2430; }
            nav { background: #0f6b63; padding: 12px 24px; display: flex; justify-content: space-between; }
            nav a { color: #fff; text-decoration: none; margin-right: 20px; font-weight: bold; }
            nav span { color: #fff; margin-right: 20px; }
            main { max-width: 1000px; margin: 24px auto; padding: 0 24px; }
            table { width: 100%; border-collapse: collapse; background: #fff; }
            th, td { padding: 10px; border-bottom: 1px solid #dce1e7; text-align: left; }
            .btn, button { background: #0f6b63; color: #fff; border: 0; padding: 8px 14px; border-radius: 4px; text-decoration: none; cursor: pointer; font-size: 14px; }
            .btn-danger { background: #b3261e; }
            form div { margin-bottom: 12px; }
            label { display: block; font-weight: bold; margin-bottom: 4px; }
            input { padding: 6px; width: 300px; }
            form ul { color: #b3261e; margin: 4px 0; padding-left: 18px; }
        </style>
    </head>
    <body>
        {# ! le menu ne s'affiche que si un utilisateur est connecté (app.user) #}
        <nav>
            <div>
                {% if app.user %}
                    <a href="{{ path('app_client_index') }}">Clients</a>
                    <a href="{{ path('app_produit_index') }}">Produits</a>
                    <a href="{{ path('app_remise_index') }}">Remises</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_register') }}">Créer un compte</a>
                    {% endif %}
                {% endif %}
            </div>
            <div>
                {% if app.user %}
                    <span>{{ app.user.userIdentifier }}</span>
                    <a href="{{ path('app_logout') }}">Déconnexion</a>
                {% endif %}
            </div>
        </nav>
        <main>
            {# ! messages de confirmation (addFlash dans les contrôleurs) #}
            {% for message in app.flashes('success') %}
                <p style="background: #e2f3e8; padding: 10px;">{{ message }}</p>
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>