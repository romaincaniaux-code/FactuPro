{% extends 'base.html.twig' %}

{% block title %}Remise index{% endblock %}

{% block body %}
    <h1>Remise index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Libelle</th>
                <th>Taux</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for remise in remises %}
            <tr>
                <td>{{ remise.id }}</td>
                <td>{{ remise.libelle }}</td>
                <td>{{ remise.taux }}</td>
                <td>
                    <a href="{{ path('app_remise_show', {'id': remise.id}) }}">show</a>
                    <a href="{{ path('app_remise_edit', {'id': remise.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_remise_new') }}">Create new</a>
{% endblock %}
